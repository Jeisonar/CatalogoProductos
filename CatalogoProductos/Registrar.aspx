<%@ Page Title="Registrar producto" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Registrar.aspx.cs" Inherits="CatalogoProductos.Registrar" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server"><main><div class="page-heading compact"><div><p class="eyebrow">HACÉ CRECER TU CATÁLOGO</p><h1>Un nuevo comienzo.<br />Un nuevo producto.</h1><p class="intro">Completá los detalles y dejá el resto en orden.</p></div><a class="text-link" href="Productos">Ver mis productos ↗</a></div>
<div class="register-layout"><section class="surface form-card"><div class="section-title"><div><h2>Información del producto</h2><p class="subtle">Los campos con * son obligatorios.</p></div><span class="step-badge">01</span></div>
<asp:Panel ID="pnlMensaje" runat="server" Visible="false" CssClass="notice error" role="alert"><asp:Literal ID="litMensaje" runat="server" Mode="Encode" /></asp:Panel>
<div class="form-grid"><div><asp:Label runat="server" AssociatedControlID="txtNombre" Text="Nombre del producto *" /><asp:TextBox ID="txtNombre" runat="server" MaxLength="100" CssClass="field" placeholder="Ej. Cuaderno de 100 hojas" /></div><div><asp:Label runat="server" AssociatedControlID="txtCategoria" Text="Categoría *" /><asp:TextBox ID="txtCategoria" runat="server" MaxLength="50" CssClass="field" placeholder="Ej. Útiles escolares" /></div><div><asp:Label runat="server" AssociatedControlID="txtPrecio" Text="Precio unitario (₡) *" /><asp:TextBox ID="txtPrecio" runat="server" MaxLength="20" inputmode="decimal" CssClass="field" placeholder="1500,00" /><small>Sin separadores de miles.</small></div><div><asp:Label runat="server" AssociatedControlID="txtExistencias" Text="Existencias *" /><asp:TextBox ID="txtExistencias" runat="server" MaxLength="10" inputmode="numeric" CssClass="field" placeholder="0" /></div><div class="full-width"><asp:Label runat="server" AssociatedControlID="txtDescripcion" Text="Descripción" /><asp:TextBox ID="txtDescripcion" runat="server" TextMode="MultiLine" Rows="4" CssClass="field" placeholder="Agregá un detalle que te ayude a identificarlo" /><small>Hasta 300 caracteres.</small></div></div>
<div class="form-actions"><a class="button secondary" href="Productos">Cancelar</a><asp:Button ID="btnGuardar" runat="server" Text="Guardar producto ↗" OnClick="Guardar_Click" CssClass="button primary" /></div></section><aside class="help-card"><span class="help-symbol">✦</span><h2>Pequeños detalles.<br />Mejor organización.</h2><p>Usá nombres claros y mantené las mismas categorías para encontrar tus productos más fácil.</p><div class="help-divider"></div><p><strong>Siempre disponible</strong><br />Al guardar, tu producto queda registrado y aparece en Mis productos.</p><span class="mini-brand">nexo.</span></aside></div></main></asp:Content>