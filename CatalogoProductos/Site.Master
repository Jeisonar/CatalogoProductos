<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="CatalogoProductos.SiteMaster" %>
<!DOCTYPE html><html lang="es"><head runat="server"><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" /><title><%: Page.Title %> · Nexo</title><link rel="stylesheet" href="Content/Site.css?v=4" /><asp:ContentPlaceHolder ID="HeadContent" runat="server" /></head>
<body><form runat="server"><header class="topbar"><div class="nav-shell"><a class="brand" href="Default"><span class="brand-mark">n</span>nexo<span class="brand-dot">.</span></a><nav aria-label="Navegación principal"><a class='<%= NavClass("Default") %>' href="Default">Inicio</a><a class='<%= NavClass("Registrar") %>' href="Registrar">Registrar producto</a><a class='<%= NavClass("Productos") %>' href="Productos">Mis productos</a></nav><div class="account"><span class="avatar">N</span><span class="account-copy">Tu espacio<small><%: Context.User.Identity.Name %></small></span><asp:Button runat="server" ID="btnSalir" Text="Salir ↗" OnClick="Salir_Click" CssClass="logout" CausesValidation="false" /></div></div></header>
<div class="app-shell"><asp:ContentPlaceHolder ID="MainContent" runat="server" /></div><footer class="footer app-shell"><span>nexo. <span class="footer-note">Tu inventario, conectado.</span></span><span>Proyecto académico · <%: DateTime.Now.Year %></span></footer></form></body></html>