<%@ Page Title="Crear cuenta" Language="C#" MasterPageFile="~/Auth.Master" AutoEventWireup="true" CodeBehind="CrearCuenta.aspx.cs" Inherits="CatalogoProductos.CrearCuenta" %>
<asp:Content ContentPlaceHolderID="AuthContent" runat="server"><div class="auth-form"><p class="eyebrow">TU NUEVO ESPACIO</p><h2>Empecemos algo.</h2><p class="auth-intro">Creá tu cuenta para acceder al catálogo compartido.</p><asp:Panel ID="pnlMensaje" runat="server" Visible="false" CssClass="notice error" role="alert"><asp:Literal ID="litMensaje" runat="server" Mode="Encode" /></asp:Panel><asp:Label runat="server" AssociatedControlID="txtNombre" Text="Tu nombre" /><asp:TextBox ID="txtNombre" runat="server" CssClass="field" MaxLength="80" autocomplete="name" /><asp:Label runat="server" AssociatedControlID="txtCorreo" Text="Correo electrónico" /><asp:TextBox ID="txtCorreo" runat="server" CssClass="field" MaxLength="160" TextMode="Email" autocomplete="username" /><asp:Label runat="server" AssociatedControlID="txtClave" Text="Contraseña" /><asp:TextBox ID="txtClave" runat="server" CssClass="field" MaxLength="128" TextMode="Password" autocomplete="new-password" /><small>Entre 10 y 128 caracteres.</small><asp:Label runat="server" AssociatedControlID="txtConfirmar" Text="Confirmar contraseña" /><asp:TextBox ID="txtConfirmar" runat="server" CssClass="field" MaxLength="128" TextMode="Password" autocomplete="new-password" /><asp:Button ID="btnCrear" runat="server" Text="Crear mi cuenta →" OnClick="Crear_Click" CssClass="button primary auth-submit" /><p class="auth-hint">¿Ya tenés cuenta? <a href="Login">Iniciá sesión</a></p></div></asp:Content>