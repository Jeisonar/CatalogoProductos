<%@ Page Title="Mis productos" Language="C#" MasterPageFile="~/Site.Master" AutoEventWireup="true" CodeBehind="Productos.aspx.cs" Inherits="CatalogoProductos.Productos" %>
<asp:Content ID="BodyContent" ContentPlaceHolderID="MainContent" runat="server"><main><div class="page-heading compact"><div><p class="eyebrow">TU CATÁLOGO</p><h1>Mis productos</h1><p class="intro">Cada producto tiene su lugar. Encontralo aquí.</p></div><a class="button primary" href="Registrar">＋ Registrar producto</a></div>
<asp:Panel ID="pnlMensaje" runat="server" Visible="false" role="status" aria-live="polite"><asp:Literal ID="litMensaje" runat="server" Mode="Encode" /></asp:Panel>
<section class="surface"><div class="filters"><div class="search-field"><asp:Label runat="server" AssociatedControlID="txtBusqueda" Text="Buscar producto" /><asp:TextBox ID="txtBusqueda" runat="server" MaxLength="100" CssClass="field" placeholder="Escribí el nombre de un producto" /></div><div><asp:Label runat="server" AssociatedControlID="ddlCategoria" Text="Categoría" /><asp:DropDownList ID="ddlCategoria" runat="server" CssClass="field" /></div><asp:Button ID="btnBuscar" runat="server" Text="Buscar" OnClick="Buscar_Click" CssClass="button primary" /><asp:Button ID="btnLimpiar" runat="server" Text="Limpiar" OnClick="Limpiar_Click" CssClass="button secondary" /></div>
<div class="list-caption"><asp:Literal ID="litResultados" runat="server" Mode="Encode" /><span>Precios en colones (CRC)</span></div><p class="mobile-table-hint">Deslizá la tabla para ver todos los detalles →</p><div class="table-wrap"><asp:GridView ID="gvProductos" runat="server" AutoGenerateColumns="false" CssClass="data-table product-table" GridLines="None" EmptyDataText="No encontramos productos con esos filtros. Probá otro nombre o elegí otra categoría." ShowHeaderWhenEmpty="true"><Columns><asp:BoundField DataField="id" HeaderText="ID" /><asp:BoundField DataField="nombre" HeaderText="Producto" /><asp:BoundField DataField="categoria" HeaderText="Categoría" /><asp:BoundField DataField="precio" HeaderText="Precio (₡)" DataFormatString="{0:N2}" /><asp:BoundField DataField="existencias" HeaderText="Existencias" /><asp:BoundField DataField="descripcion" HeaderText="Descripción" /></Columns></asp:GridView></div></section><div class="info-strip"><span class="status-dot"></span> Tu catálogo está guardado y disponible al volver a entrar.</div></main></asp:Content>