<%@ Page Title="Iniciar sesión" Language="C#" MasterPageFile="~/Auth.Master" AutoEventWireup="true" CodeBehind="Login.aspx.cs" Inherits="CatalogoProductos.Login" %>
<asp:Content ContentPlaceHolderID="AuthContent" runat="server"><div class="auth-form"><span class="welcome-mark">↗</span><p class="eyebrow">BIENVENIDO A NEXO</p><h2>Qué bueno verte.</h2><p class="auth-intro">Entrá a tu cuenta y seguí donde lo dejaste.</p><asp:Panel ID="pnlMensaje" runat="server" Visible="false" CssClass="notice error" role="alert"><asp:Literal ID="litMensaje" runat="server" Mode="Encode" /></asp:Panel><asp:Label runat="server" AssociatedControlID="txtCorreo" Text="Correo electrónico" /><asp:TextBox ID="txtCorreo" runat="server" CssClass="field" MaxLength="160" TextMode="Email" autocomplete="username" placeholder="tu@correo.com" /><asp:Label runat="server" AssociatedControlID="txtClave" Text="Contraseña" /><asp:TextBox ID="txtClave" runat="server" CssClass="field" MaxLength="128" TextMode="Password" autocomplete="current-password" placeholder="Tu contraseña" /><asp:Button ID="btnEntrar" runat="server" Text="Iniciar sesión →" OnClick="Entrar_Click" CssClass="button primary auth-submit" /><div class="auth-separator"><span>¿Es tu primera vez?</span></div><a class="button secondary auth-submit" href="CrearCuenta">Crear una cuenta</a><p class="auth-hint">Tu cuenta te da acceso al catálogo compartido del proyecto.</p></div></asp:Content>